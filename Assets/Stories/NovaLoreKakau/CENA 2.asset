  - guid: ae1ad85d-7582-4f61-a90c-bc6bbea4deb1
    characterSpr: {fileID: 21300000, guid: 99a863cee5ec77b4abfbfe752589f19c, type: 3}
    characterName: "Voc\xEA"
    dialogueText: "Frankeline\u2026\n\n\xC9 um nome bonito.\nMas meio longo.\n\nQue
      tal Frankie?"
    backgroundSpr: {fileID: -2993863927487691792, guid: f940f73258af2d24da9af4c61fc5b639, type: 3}
    startNode: 0
    endNode: 0
    choices: 1
