  - guid: 7ea8e203-9ea1-45a5-b0d4-c01eaaff873b
    characterSpr: {fileID: 21300000, guid: 7f01622113486ae4d9c587e6a83f0445, type: 3}
    characterName: Frankie
    dialogueText: "PR\xD3XIMAS??\r\nA-ah\u2026\r\nEnt\xE3o n\xF3s somos pr\xF3ximos?\r\n"
    backgroundSpr: {fileID: -2993863927487691792, guid: f940f73258af2d24da9af4c61fc5b639, type: 3}
    startNode: 0
    endNode: 0
    choices: 1
    choiceOptions:
    - 
    nodePosition:
      serializedVersion: 2
      x: 9728
      y: 252
      width: 501.333
      height: 374.6667
    soundEffect: {fileID: 0}
    backgroundMusic: {fileID: 0}
    likeGain: 5
    showLikeBar: 0
  - guid: 6ac8e030-7a9b-446b-b9d7-362ee66cb1cf
    characterSpr: {fileID: 21300000, guid: 7f01622113486ae4d9c587e6a83f0445, type: 3}
    characterName: "Voc\xEA"
    dialogueText: "Ah\u2026\r\nAcho que sim.\r\nQuer dizer, voc\xEA me ajudou no
      elevador.\r\nE honestamente\u2026\r\nvoc\xEA \xE9 mais legal que metade desse
      escrit\xF3rio.\r\n"
    backgroundSpr: {fileID: -2993863927487691792, guid: f940f73258af2d24da9af4c61fc5b639, type: 3}
    startNode: 0
    endNode: 0
    choices: 1
