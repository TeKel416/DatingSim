  - guid: e7007c54-f26c-42f8-bcb3-697facf22fe1
    characterSpr: {fileID: 21300000, guid: 99a863cee5ec77b4abfbfe752589f19c, type: 3}
    characterName: Nova chefe
    dialogueText: "Eu tentei me conectar aos eletr\xF4nicos do escrit\xF3rio.\nAinda
