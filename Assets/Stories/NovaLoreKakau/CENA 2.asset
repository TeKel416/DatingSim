    characterSpr: {fileID: 21300000, guid: 355c0b539342aa740961e76c1806d3d3, type: 3}
    characterName: "Voc\xEA"
    dialogueText: ' Foi meio esquisito, nunca falei com uma cafeteira, muito menos
