  - guid: c4b94fc6-3fd4-468b-be2a-1541ca6717a8
    characterSpr: {fileID: 21300000, guid: 7f01622113486ae4d9c587e6a83f0445, type: 3}
    characterName: "Voc\xEA"
    dialogueText: "Isso foi bem bacana na verdade.\n\nMas agora fala\u2026\nqual
      \xE9 seu nome?"
    backgroundSpr: {fileID: -2993863927487691792, guid: f940f73258af2d24da9af4c61fc5b639, type: 3}
    startNode: 0
    endNode: 0
    choices: 1
